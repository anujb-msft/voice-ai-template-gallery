# Copy to .env (gitignored). Every value below is a placeholder.

# --------------------------------------------- Azure Communication Services
# The resource that owns BOTH phone numbers. Keyless: DefaultAzureCredential
# (az login locally) needs "Communication and Email Service Owner" on it.
ACS_ENDPOINT=https://<acs>.unitedstates.communication.azure.com

# The number a template answers. Its Event Grid subscription (IncomingCall,
# filtered to this number) points at TEMPLATE_PUBLIC_URL/api/events.
TEMPLATE_NUMBER=+18005550100

# A second ACS number the harness owns. It calls TEMPLATE_NUMBER, and it answers
# the calls that outbound templates place. Give it its own Event Grid
# subscription (IncomingCall, filtered to this number) pointing at
# HARNESS_PUBLIC_URL/api/events.
HARNESS_NUMBER=+14255550123

# --------------------------------------------------------------- templates
# One template runs at a time, on this port, behind this public URL.
TEMPLATE_PORT=8091
TEMPLATE_PUBLIC_URL=https://<template-tunnel>-8091.<region>.devtunnels.ms

# Voice Live resource the templates use (keyless).
VOICE_LIVE_ENDPOINT=https://<resource>.services.ai.azure.com

# Templates run hermetically: they never read their own .env during a run.
# They get this file, the suite's settings, and their defaults. Anything else
# a template needs (say VOICE_LIVE_API_KEY, if you don't use keyless auth)
# goes here and reaches every template.

# ----------------------------------------------------------------- harness
HARNESS_PORT=8089
HARNESS_PUBLIC_URL=https://<harness-tunnel>-8089.<region>.devtunnels.ms

# Azure AI Speech, used to speak the caller's lines and transcribe the agent.
# An AI Services resource with a custom subdomain works; keyless, which needs
# "Cognitive Services User" on it.
SPEECH_ENDPOINT=https://<resource>.cognitiveservices.azure.com
HARNESS_VOICE=en-US-AndrewNeural
