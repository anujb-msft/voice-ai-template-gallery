# Keep LF in every working tree so the samples behave the same in Windows, WSL,
# macOS, and CI checkouts. Markdown front matter and fixtures are parsed by line.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.mp3 binary
*.mp4 binary
*.wav binary
*.webm binary
*.pdf binary
*.pptx binary
*.woff binary
*.woff2 binary
*.zip binary
