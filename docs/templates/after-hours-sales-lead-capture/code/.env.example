# After-Hours Sales Lead Capture sample. Copy to .env for live calls; never commit secrets.
HOST=127.0.0.1
PORT=8093
PUBLIC_BASE_URL=

# ACS Call Automation: prefer keyless endpoint auth; connection string is accepted for quick-start fallback.
ACS_ENDPOINT=
ACS_CONNECTION_STRING=
TEAMS_CLOUD=public

# Voice Live direct mode.
VOICE_LIVE_ENDPOINT=
VOICE_LIVE_API_KEY=
VOICE_LIVE_MODEL=gpt-realtime
VOICE_LIVE_API_VERSION=2026-04-10
VOICE_LIVE_VOICE=en-US-Ava:DragonHDLatestNeural
LOCALE=en-US

# Sales capture behavior.
DEDUPE_WINDOW_DAYS=30
CALL_TIME_BUDGET_MS=360000
# How long a paged caller holds before the transfer to the on-call rep.
PAGE_WINDOW_MS=6000
PERSIST_TRANSCRIPTS=false
DB_PATH=./data/after-hours-sales.db

# Simulation only: pin the demo clock, for example 2026-09-02T19:30:00-07:00. Ignored on real calls.
DEMO_NOW=

# Reserved for delivering the follow-up messages; not used yet, so messages stay in the outbox.
TEAMS_WORKFLOW_URL=
ACS_EMAIL_SENDER=
