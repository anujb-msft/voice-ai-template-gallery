# Copy to .env only to answer real calls. With none of the three settings below
# (ACS_ENDPOINT or ACS_CONNECTION_STRING, PUBLIC_BASE_URL, VOICE_LIVE_ENDPOINT),
# the sample runs in simulation mode and the console drives simulated calls.

# ------------------------------------------------------------------ web server
HOST=127.0.0.1
PORT=8100
# Public HTTPS base URL that ACS can reach, for the Event Grid webhook, the call
# callbacks and the media socket. With devtunnel:
#   devtunnel host -p 8100 --allow-anonymous
# PUBLIC_BASE_URL=https://<your-tunnel>.devtunnels.ms
PUBLIC_BASE_URL=

# ------------------------------------------------- Azure Communication Services
# Preferred: keyless. Set the endpoint only, and the sample authenticates with
# DefaultAzureCredential: `az login` locally, managed identity in Azure.
# ACS_ENDPOINT=https://<acs>.unitedstates.communication.azure.com
ACS_ENDPOINT=
# Fallback, only if you cannot use Entra. If both are set, ACS_ENDPOINT wins.
# ACS_CONNECTION_STRING=endpoint=https://<acs>.communication.azure.com/;accesskey=<key>
ACS_CONNECTION_STRING=
# The Teams resource account the scheduling number is assigned to. Shown on
# /health so you can confirm which account this server answers for.
TEAMS_RESOURCE_ACCOUNT_ID=
# Only change this for a sovereign Teams tenant: public | dod | gcch
TEAMS_CLOUD=public

# ------------------------------------------------------------- Voice Live API
# Azure AI Services (kind=AIServices) resource in a region that serves the model.
# VOICE_LIVE_ENDPOINT=https://<resource>.services.ai.azure.com
VOICE_LIVE_ENDPOINT=
# Leave empty to use DefaultAzureCredential (keyless).
VOICE_LIVE_API_KEY=
VOICE_LIVE_MODEL=gpt-realtime
# WebSocket transport api-version.
VOICE_LIVE_API_VERSION=2026-04-10
VOICE_LIVE_VOICE=en-US-Ava:DragonHDLatestNeural
# The conversation language in the agent's instructions. Change the voice with it.
LOCALE=en-US

# ------------------------------------------------------------ scheduling policy
# Times read out per turn. Two is what a caller can hold in their head.
OPTIONS_PER_TURN=2
# Nothing sooner than this is offered, so the caller can still get there.
MIN_LEAD_MINUTES=60
# How far ahead a search looks.
SEARCH_HORIZON_DAYS=90
# How long a time read back to the caller stays held while they decide.
HOLD_TTL_MS=300000
# Answer-to-hang-up budget on a real call. Past it, a person takes over.
CALL_TIME_BUDGET_MS=420000
# The gap between "I'm connecting you" and the transfer on a real call, so the
# caller hears the whole line first. Set to 0 to transfer immediately.
TRANSFER_DELAY_MS=2500

# -------------------------------------------------------------------- schedule
# The schedule database. Default: data/schedule.db, created from the seed on
# first start. In simulation, leave it unset: simulated calls then book into an
# in-memory copy of the seed that the console's Reset demo restores, so every
# run starts from the same day and nothing lands in a file real calls use.
# SCHEDULE_DB_PATH=./data/schedule.db
# SCHEDULE_SEED_PATH=./fixtures/appointments-seed.json

# ---------------------------------------------------- reminder agent handoff
# A caller transferred in by the appointment reminder agent carries a one-time
# token instead of repeating their date of birth. Tokens are stored in the
# schedule database; with a shared secret, a signed token issued by another
# process redeems too. Leave empty unless both agents share it.
HANDOFF_TOKEN_SECRET=
HANDOFF_TOKEN_TTL_MS=300000

# ----------------------------------------------------------------------- audit
# Default: data/scheduling-audit.db. Decisions and events are always stored.
# What callers said is not, unless you turn this on deliberately.
# DB_PATH=./data/scheduling-audit.db
TRANSCRIPT_RETENTION=false

# ------------------------------------------------------------------------ demo
# Simulation only. The clock the schedule sees: openings, lead times and
# "today" all depend on it. Unset, the demo starts on Tuesday, May 19, 2026 at
# 9:50 AM (the console's tue-morning preset); set it empty to use the real
# time. The console's demo clock can still move it. Ignored when the sample
# answers real calls.
# DEMO_NOW=2026-05-19T09:50:00-07:00
