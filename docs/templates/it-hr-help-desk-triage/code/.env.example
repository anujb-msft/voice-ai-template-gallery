# Copy to .env for real calls. While PUBLIC_BASE_URL, ACS_ENDPOINT (or
# ACS_CONNECTION_STRING) or VOICE_LIVE_ENDPOINT is empty, the sample runs in
# simulation mode: no Azure, no phone number and no network needed.

# ------------------------------------------------------------------ web server
HOST=127.0.0.1
PORT=8098
# Public HTTPS base URL that ACS can reach, for the Event Grid webhook, the call
# callbacks and the media socket. With devtunnel: npm run tunnel
PUBLIC_BASE_URL=

# ------------------------------------------- ACS / Teams Phone extensibility
# Preferred: keyless. Set the endpoint only, and the sample authenticates with
# DefaultAzureCredential — `az login` locally, managed identity in Azure.
ACS_ENDPOINT=
# Fallback, only if you cannot use Entra. If both are set, ACS_ENDPOINT wins.
ACS_CONNECTION_STRING=
# Only change this for a sovereign Teams tenant: public | dod | gcch
TEAMS_CLOUD=public

# ------------------------------------------------------------- Voice Live API
VOICE_LIVE_ENDPOINT=
# Leave empty to use DefaultAzureCredential (Cognitive Services User and Foundry User roles).
VOICE_LIVE_API_KEY=
VOICE_LIVE_MODEL=gpt-realtime
VOICE_LIVE_API_VERSION=2026-04-10
VOICE_LIVE_VOICE=en-US-Ava:DragonHDLatestNeural
LOCALE=en-US

# ----------------------------------------------------------- triage policy
# memory | sqlite. Simulated tickets are cleared by the console's Reset demo either way.
TICKET_ADAPTER=sqlite
HRIS_ADAPTER=fixture
# Where one-time codes go: teams | email | sms. Simulated calls never send one;
# for real calls, delivery is a stub until you wire src/adapters/otp.mjs.
OTP_CHANNEL=teams
# Empty files a ticket instead of handing unlocks and MFA to a password reset agent.
PASSWORD_RESET_TARGET=
# Below this, the agent asks one clarifying question instead of guessing.
CLASSIFIER_CONFIDENCE_MIN=0.7
# The call's time limit, and when the agent starts offering a ticket or a person.
CALL_TIME_BUDGET_MS=360000
WRAP_UP_MS=300000

# ----------------------------------------------------------------------- audit
DB_PATH=./data/triage.db
# Caller words are not stored unless you turn this on. Private HR words never are.
TRANSCRIPT_RETENTION=false
TRANSCRIPT_RETENTION_DAYS=30
# Private HR counts below this show in /api/stats as "<" and this number, so nobody can be singled out.
STATS_MIN_COUNT=5

# ------------------------------------------------------------------------ demo
# Simulation mode only. Pins the clock the policy sees at startup (support
# hours, the Outlook outage, article review dates, code expiry); the console's
# demo clock can still move it, and Reset demo returns to it. Ignored when the
# sample answers real calls. This value is the console's "Business hours" preset.
# DEMO_NOW=2026-05-15T10:30:00-07:00
