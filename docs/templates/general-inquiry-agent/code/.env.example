# General Inquiry Agent local configuration. Copy to .env for local runs.
PORT=8092
HOST=127.0.0.1
PUBLIC_BASE_URL=

# ACS Call Automation. Prefer ACS_ENDPOINT with managed identity / DefaultAzureCredential.
ACS_ENDPOINT=
ACS_CONNECTION_STRING=
TEAMS_CLOUD=public

# Azure AI Voice Live. API key is only a quick-start fallback; keyless auth is preferred.
VOICE_LIVE_ENDPOINT=
VOICE_LIVE_API_KEY=
VOICE_LIVE_MODEL=gpt-realtime
VOICE_LIVE_API_VERSION=2026-04-10
VOICE_LIVE_VOICE=en-US-Ava:DragonHDLatestNeural
LOCALE=en-US

# Demo controls.
# Simulation mode only. Pins the clock the grounding policy sees (content
# freshness, open hours and staffed hours), so the demo is the same on every
# run. DEMO_TODAY=YYYY-MM-DD does the same at noon UTC-7 on that date. The console's
# demo clock can still move it. Both are ignored when the sample answers real
# calls, so real callers always get answers judged on the real date.
# DEMO_NOW=2026-09-30T10:00:00-07:00
# DEMO_TODAY=
CALL_TIME_BUDGET_MS=300000
RETRIEVAL_MIN_SCORE=2.5
CONTENT_EXPIRY_GRACE_DAYS=90
PERSIST_TRANSCRIPTS=false
DB_PATH=./data/general-inquiry.db
CONTENT_ARTICLES_PATH=./content/articles
HOURS_PATH=./config/hours.json
