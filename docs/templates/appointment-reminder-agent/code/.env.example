# Appointment Reminder Agent. Copy this file to .env.
# With the call settings below left empty, the server runs in simulation mode:
# the console works, and nothing is dialed. Real calls need ACS_ENDPOINT (or
# ACS_CONNECTION_STRING), ACS_CALLER_ID, PUBLIC_BASE_URL and VOICE_LIVE_ENDPOINT.

# ------------------------------------------------------------------ web server
HOST=127.0.0.1
PORT=8099
# Public HTTPS base URL that ACS and Event Grid can reach, for the call
# callbacks, the media socket and the Event Grid webhook. With devtunnel
# (npm run tunnel), for example:
#   PUBLIC_BASE_URL=https://<your-tunnel>.devtunnels.ms
PUBLIC_BASE_URL=

# ------------------------------------------------- Azure Communication Services
# Preferred: keyless. Set the endpoint only, and the sample authenticates with
# DefaultAzureCredential — `az login` locally, managed identity in Azure. No ACS
# key is ever written to disk. The signed-in identity needs the
# "Communication and Email Service Owner" role on the ACS resource. For example:
#   ACS_ENDPOINT=https://<acs>.unitedstates.communication.azure.com
ACS_ENDPOINT=
# Fallback, only if you cannot use Entra. If both are set, ACS_ENDPOINT wins.
# ACS_CONNECTION_STRING=endpoint=https://<acs>.communication.azure.com/;accesskey=<key>

# The ACS phone number reminder calls come from, in E.164 (+<country><number>).
ACS_CALLER_ID=
# Informational only: the Teams resource account linked for callbacks, shown in
# /health.
TEAMS_RESOURCE_ACCOUNT_ID=

# ------------------------------------------------------------- Voice Live API
# Azure AI Services resource in a region that serves the model. For example:
#   VOICE_LIVE_ENDPOINT=https://<resource>.services.ai.azure.com
VOICE_LIVE_ENDPOINT=
# Leave empty to use DefaultAzureCredential, which is what Microsoft recommends.
# Keyless needs the Cognitive Services User and Foundry User roles — see the README.
VOICE_LIVE_API_KEY=
VOICE_LIVE_MODEL=gpt-realtime
# WebSocket transport api-version.
VOICE_LIVE_API_VERSION=2026-04-10
# One voice for every call. Each call speaks the patient's preferred language, so
# choose a voice that also speaks Spanish if you call Spanish-speaking patients.
VOICE_LIVE_VOICE=en-US-Ava:DragonHDLatestNeural

# ------------------------------------------------------------- campaign policy
# Real dialing needs both CAMPAIGN_ENABLED=true and CAMPAIGN_DRY_RUN=false.
# Anything less, and POST /api/campaign/run returns the dial plan and dials nobody.
# Who may be called, and when, lives in config/campaign.json.
CAMPAIGN_ENABLED=false
CAMPAIGN_DRY_RUN=true
# Reminder calls in flight at once.
CAMPAIGN_MAX_CONCURRENT=2
# Comma-separated E.164 numbers. When set, a real campaign run dials only these.
# Empty filters nothing, so set it while you test.
ALLOWED_TEST_NUMBERS=
# From answer to goodbye. The agent starts wrapping up 40 seconds before the end.
CALL_TIME_BUDGET_MS=240000
# A simulated greeting at least this long counts as voicemail. A real call is
# judged on its first words (config/detection.json).
VOICEMAIL_GREETING_MS=4500

# ------------------------------------------------------------- scheduling desk
# Who takes a request for a new time: a Teams user's Microsoft Entra object ID,
# or +E.164. Overrides config/routing.json. Empty: on a real call the request
# becomes a callback request, and nothing is transferred.
SCHEDULING_AGENT_TARGET=
# Signs the patientRef sent to the desk with HMAC. Empty: a random single-use
# token that only this schedule database can redeem.
HANDOFF_TOKEN_SECRET=
# How long a patientRef can be redeemed.
# HANDOFF_TOKEN_TTL_MS=300000

# ------------------------------------------------------------ data and audit
# The defaults live in data/ and fixtures/ next to this file. A relative path you
# set here is relative to where you start the server; :memory: gives a throwaway
# database.
# SCHEDULE_DB_PATH=./data/schedule.db
# SCHEDULE_SEED_PATH=./fixtures/appointments-seed.json
# AUDIT_DB_PATH=./data/reminder-audit.db
# Decisions and outcomes are always stored. Utterance text is not, unless you
# turn this on deliberately.
TRANSCRIPT_RETENTION=false
# Not enforced yet: nothing purges old transcripts.
TRANSCRIPT_RETENTION_DAYS=7

# ------------------------------------------------------------------------ demo
# Simulation mode only: the demo clock's starting time, two days before the
# seeded appointments. Empty means real time. The console's demo clock can still
# move it. Ignored when the server places real calls.
DEMO_NOW=2026-05-19T10:00:00-07:00
