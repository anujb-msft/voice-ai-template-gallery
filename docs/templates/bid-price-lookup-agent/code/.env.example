# The demo needs none of this. `npm start` with no .env runs simulation mode:
# the presenter console, the demo clock and the fixture bid sheet, no Azure.
# Copy this file to .env only when you are ready to answer real calls.

# ------------------------------------------------------------------ web server
HOST=127.0.0.1
PORT=8094
# Public HTTPS base URL that ACS can reach, for the Event Grid webhook, the call
# callbacks, and the media socket. With devtunnel (`npm run tunnel`):
#   devtunnel host -p 8094 --allow-anonymous
PUBLIC_BASE_URL=https://<your-tunnel>.devtunnels.ms

# ------------------------------------------------- Azure Communication Services
# Preferred: keyless. Set the endpoint only, and the sample authenticates with
# DefaultAzureCredential — `az login` locally, managed identity in Azure. No ACS
# key is ever written to disk. The signed-in identity needs the
# "Communication and Email Service Owner" role on the ACS resource.
ACS_ENDPOINT=https://<acs>.unitedstates.communication.azure.com

# Fallback, only if you cannot use Entra. If both are set, ACS_ENDPOINT wins.
# ACS_CONNECTION_STRING=endpoint=https://<acs>.communication.azure.com/;accesskey=<key>

# Only change this for a sovereign Teams tenant: public | dod | gcch
TEAMS_CLOUD=public

# ------------------------------------------------------------- Voice Live API
# Azure AI Services (kind=AIServices) resource in a region that serves the model.
# For natively supported models and their regions, see
# https://learn.microsoft.com/azure/ai-services/speech-service/voice-live#supported-models-and-regions
VOICE_LIVE_ENDPOINT=https://<resource>.services.ai.azure.com
# Leave empty to use DefaultAzureCredential, which is what Microsoft recommends.
# Keyless needs the Cognitive Services User and Foundry User roles — see the README.
VOICE_LIVE_API_KEY=
VOICE_LIVE_MODEL=gpt-realtime
# WebSocket transport api-version.
VOICE_LIVE_API_VERSION=2026-04-10
VOICE_LIVE_VOICE=en-US-Ava:DragonHDLatestNeural
# The opening language, the standing instructions and the transcription hint.
# The caller can still explicitly ask to switch languages.
LOCALE=en-US

# ------------------------------------------------------------- pricing policy
# Names the price source on the price card and in /health. The sample ships only
# the fixture feed, which reads config/bids.json and config/futures.json. Replace
# it with a licensed market-data feed before real use.
PRICE_FEED=fixture
# Futures older than this are still quoted, with "These prices may be delayed."
FUTURES_STALE_MINUTES=20
# Futures older than this are never quoted as current: the agent gives the last
# settlement and says so.
FUTURES_HARD_LIMIT_MINUTES=240
# How long a real call may run before the agent closes politely. Simulated calls
# are exempt, because the presenter talks to the room between lines.
CALL_TIME_BUDGET_MS=180000

# Point these at *.local.json copies to try the sample with your own locations,
# merchandiser object IDs and bids without putting them into the shipped config.
# config/*.local.json is gitignored.
# LOCATIONS_PATH=./config/locations.json
# BIDS_PATH=./config/bids.json
# FUTURES_PATH=./config/futures.json
# MARKET_PATH=./config/market.json

# ----------------------------------------------------------------------- audit
DB_PATH=./data/bid-price-lookup.db
# Calls, their event trail and the quotes given are always stored. Utterance
# text is not, unless you turn this on deliberately.
PERSIST_TRANSCRIPTS=false

# ------------------------------------------------------------------------ demo
# Simulation mode only. Starts the demo clock the pricing policy sees at a preset
# (prices-fresh, prices-stale, after-close, after-hours, real) or at an ISO 8601
# time. Without it the clock starts at prices-fresh: Tuesday, September 8, 2026,
# 10:45 AM Central, the morning the fixture bid sheet was posted. The console's
# demo clock can still move it. Ignored when the sample answers real calls.
# DEMO_NOW=prices-fresh
