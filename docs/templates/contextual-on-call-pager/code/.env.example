# Local server
HOST=127.0.0.1
PORT=8095
# Leave empty (or leave any of ACS_*, VOICE_LIVE_ENDPOINT empty) to run in simulation mode.
PUBLIC_BASE_URL=

# ACS Call Automation. Prefer ACS_ENDPOINT with DefaultAzureCredential.
ACS_ENDPOINT=
ACS_CONNECTION_STRING=
# The caller ID that pages and tenant callbacks present, in E.164 form, e.g. +12065550100. It must be a number
# this ACS resource can place calls from; see README.md, "Connecting it to a real phone number".
ACS_OUTBOUND_CALLER_ID=
TEAMS_CLOUD=public

# Voice Live direct realtime mode. Prefer DefaultAzureCredential; API key is a quick-start fallback.
VOICE_LIVE_ENDPOINT=
VOICE_LIVE_API_KEY=
VOICE_LIVE_MODEL=gpt-realtime
VOICE_LIVE_API_VERSION=2026-04-10
VOICE_LIVE_VOICE=en-US-Ava:DragonHDLatestNeural
LOCALE=en-US

# Teams Workflows incoming webhook URLs. Empty values record the card locally instead of posting it.
TEAMS_WORKFLOW_URL=
TEAMS_OPS_WORKFLOW_URL=

# Demo/runtime controls
# DEMO_NOW pins the demo clock at startup (simulation mode only), e.g. 2026-09-30T23:42:00-07:00.
# Empty starts on the "Weeknight on call" preset; the console's clock presets move it.
DEMO_NOW=
INTAKE_TIME_BUDGET_MS=300000
PAGE_TIME_BUDGET_MS=180000
CALL_TIME_BUDGET_MS=300000
PERSIST_TRANSCRIPTS=false
DB_PATH=./data/pager.db
