# Local server
HOST=127.0.0.1
PORT=8095
PUBLIC_BASE_URL=

# ACS Call Automation. Prefer ACS_ENDPOINT with DefaultAzureCredential.
ACS_ENDPOINT=
ACS_CONNECTION_STRING=
ACS_OUTBOUND_CALLER_ID=+15551239999
TEAMS_CLOUD=public

# Voice Live direct realtime mode. Prefer DefaultAzureCredential; API key is a quick-start fallback.
VOICE_LIVE_ENDPOINT=
VOICE_LIVE_API_KEY=
VOICE_LIVE_MODEL=gpt-realtime
VOICE_LIVE_API_VERSION=2026-04-10
VOICE_LIVE_VOICE=en-US-Ava:DragonHDLatestNeural
LOCALE=en-US

# Teams Workflows incoming webhook URLs. Empty values simulate delivery.
TEAMS_WORKFLOW_URL=
TEAMS_OPS_WORKFLOW_URL=

# Demo/runtime controls
DEMO_NOW=2026-09-30T23:42:00-07:00
INTAKE_TIME_BUDGET_MS=300000
PAGE_TIME_BUDGET_MS=180000
CALL_TIME_BUDGET_MS=300000
PERSIST_TRANSCRIPTS=false
DB_PATH=./data/pager.db
