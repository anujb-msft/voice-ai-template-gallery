# ---------------------------------------------------------------- web server
HOST=127.0.0.1
PORT=8090
# Public HTTPS base URL that ACS can reach. With devtunnel:
#   devtunnel host -p 8090 --allow-anonymous
PUBLIC_BASE_URL=https://<your-tunnel>.devtunnels.ms

# ------------------------------------------------- Azure Communication Services
ACS_CONNECTION_STRING=endpoint=https://<acs>.communication.azure.com/;accesskey=<key>
# Must be a GEOGRAPHIC number. Toll-free numbers cannot place outbound calls.
ACS_CALLER_ID=+1XXXXXXXXXX

# ------------------------------------------------------------ Voice Live API
# Azure AI Services (kind=AIServices) resource in a region that serves the model.
# For natively supported models and their regions, see
# https://learn.microsoft.com/azure/ai-services/speech-service/voice-live#supported-models-and-regions
VOICE_LIVE_ENDPOINT=https://<resource>.services.ai.azure.com
VOICE_LIVE_API_KEY=<key>
# gpt-realtime is the stable default. gpt-realtime-1.5 is newer; gpt-realtime-mini is cheaper.
VOICE_LIVE_MODEL=gpt-realtime
# WebSocket transport api-version.
VOICE_LIVE_API_VERSION=2026-04-10
VOICE_LIVE_VOICE=en-US-Ava:DragonHDLatestNeural

# ------------------------------------------------------------ Azure SignalR
# Optional. Leave empty to use the built-in WebSocket hub instead.
# The resource must be created in Serverless service mode.
AZURE_SIGNALR_CONNECTION_STRING=
AZURE_SIGNALR_HUB=helpdesk

# ------------------------------------------------------------------- providers
DIRECTORY_PROVIDER=sqlite
TICKETING_PROVIDER=sqlite
DB_PATH=./data/helpdesk.db

# ----------------------------------------------------------------- demo tuning
# The number the demo always calls back, regardless of the directory record.
DEMO_PHONE_NUMBER=+1XXXXXXXXXX
# Loaded cost of one human-handled password reset ticket, used by the value panel.
HELPDESK_TICKET_COST_USD=25
HELPDESK_TICKET_MINUTES=18
