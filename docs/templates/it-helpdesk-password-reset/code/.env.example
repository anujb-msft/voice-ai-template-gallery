# Copy to .env and fill in to place real calls. With no .env, or with any call
# setting below left as a placeholder, the server runs in simulation mode: the
# console plays the employee's phone and browser, and nothing is dialed.

# ---------------------------------------------------------------- web server
HOST=127.0.0.1
PORT=8090
# Public HTTPS base URL that ACS can reach. With devtunnel:
#   devtunnel host -p 8090 --allow-anonymous
PUBLIC_BASE_URL=https://<your-tunnel>.devtunnels.ms

# ------------------------------------------------- Azure Communication Services
ACS_CONNECTION_STRING=endpoint=https://<acs>.communication.azure.com/;accesskey=<key>
# teams-phone: call the employee back through Teams Phone extensibility, from a Teams resource account.
# acs-direct: call from an ACS geographic number instead.
TELEPHONY_MODE=teams-phone
# Required for TELEPHONY_MODE=teams-phone. Use the Teams resource account object ID,
# not the bot application ID, tenant ID, or phone number.
TPE_RESOURCE_ACCOUNT_ID=00000000-0000-0000-0000-000000000000
# Required only for TELEPHONY_MODE=acs-direct. Must be a GEOGRAPHIC ACS number.
ACS_CALLER_ID=+1XXXXXXXXXX

# ------------------------------------------------------------ Voice Live API
# Azure AI Services (kind=AIServices) resource in a region that serves the model.
# For natively supported models and their regions, see
# https://learn.microsoft.com/azure/ai-services/speech-service/voice-live#supported-models-and-regions
VOICE_LIVE_ENDPOINT=https://<resource>.services.ai.azure.com
VOICE_LIVE_API_KEY=<key>
# gpt-realtime is the default; gpt-realtime-1.5 and gpt-realtime-mini also work.
VOICE_LIVE_MODEL=gpt-realtime
# WebSocket transport api-version.
VOICE_LIVE_API_VERSION=2026-04-10
VOICE_LIVE_VOICE=en-US-Ava:DragonHDLatestNeural
# The agent's language. Change it together with the voice.
LOCALE=en-US

# ---------------------------------------------------- IT service desk in Teams
# Where a handoff goes: a Teams call queue's resource account (app) or a named
# specialist (user), by Microsoft Entra object ID. Leave it empty and the agent
# ends the call after its handoff line instead of transferring.
SERVICE_DESK_TEAMS_ID=
SERVICE_DESK_TEAMS_KIND=app
# public, dod or gcch. Change it only for a sovereign Teams tenant.
TEAMS_CLOUD=public
# Milliseconds between the agent's handoff line and the transfer, so the line is heard.
TRANSFER_DELAY_MS=4000

# ------------------------------------------------------------ Azure SignalR
# Optional. Leave empty to use the built-in WebSocket hub instead.
# The resource must be created in Serverless service mode.
AZURE_SIGNALR_CONNECTION_STRING=
AZURE_SIGNALR_HUB=helpdesk

# ------------------------------------------------------------------- providers
DIRECTORY_PROVIDER=sqlite
TICKETING_PROVIDER=sqlite
DB_PATH=./data/helpdesk.db

# ------------------------------------------------------------------------ demo
# The number the demo always calls back, regardless of the directory record.
DEMO_PHONE_NUMBER=+1XXXXXXXXXX
# Simulation only: pin the starting demo clock (ISO 8601) so code expiry plays
# out the same way every run. Ignored by a server placing real calls.
# DEMO_NOW=2026-09-30T09:05:00-07:00
