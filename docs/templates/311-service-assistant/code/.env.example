# 311 Service Assistant local settings. Copy to .env; never commit .env.
# With ACS_ENDPOINT (or ACS_CONNECTION_STRING), PUBLIC_BASE_URL or VOICE_LIVE_ENDPOINT
# unset, the server runs in simulation mode: no real calls, transfers or texts.
HOST=127.0.0.1
PORT=8096
PUBLIC_BASE_URL=

# ACS: prefer endpoint + DefaultAzureCredential. Connection string is a quick-start fallback.
ACS_ENDPOINT=
ACS_CONNECTION_STRING=
# An SMS-capable number on the ACS resource. Leave empty and live callers are not
# offered text updates. Simulated calls show texts on the console and never send them.
ACS_SMS_FROM=
TEAMS_CLOUD=public

# Voice Live direct mode. Leave VOICE_LIVE_API_KEY empty to use Entra.
VOICE_LIVE_ENDPOINT=
VOICE_LIVE_API_KEY=
VOICE_LIVE_MODEL=gpt-realtime
VOICE_LIVE_API_VERSION=2026-04-10
VOICE_LIVE_VOICES=en-US-Ava:DragonHDLatestNeural,es-US-PalomaNeural
LOCALES=en-US,es-US

# sqlite or memory. If SQLite can't load, the server falls back to memory and logs why.
CASE_STORE=sqlite
DB_PATH=./data/311-service.db
GEOCODER=fixture
DUPLICATE_RADIUS_M=50
DUPLICATE_WINDOW_DAYS=7
MAX_REQUESTS_PER_CALL=3
# Recorded setting only: this sample does not purge cases.
CASE_RETENTION_DAYS=365
CONTENT_EXPIRY_GRACE_DAYS=90
CALL_TIME_BUDGET_MS=300000
PERSIST_TRANSCRIPTS=false

# Simulation only: start the demo clock at this time (ISO 8601). Ignored on real calls.
# The console's scripted beats pick their own clock, so this is rarely needed.
# Business hours: 2026-09-30T10:30:00-07:00   After hours: 2026-09-30T19:30:00-07:00
# DEMO_NOW=2026-09-30T10:30:00-07:00
