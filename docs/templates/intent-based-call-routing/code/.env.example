# ------------------------------------------------------------------ web server
HOST=127.0.0.1
PORT=8091
# Public HTTPS base URL that ACS can reach, for the Event Grid webhook, the call
# callbacks, and the media socket. With devtunnel:
#   devtunnel host -p 8091 --allow-anonymous
PUBLIC_BASE_URL=https://<your-tunnel>.devtunnels.ms

# ------------------------------------------------- Azure Communication Services
ACS_CONNECTION_STRING=endpoint=https://<acs>.communication.azure.com/;accesskey=<key>
# Only change this for a sovereign Teams tenant: public | dod | gcch
TEAMS_CLOUD=public

# ------------------------------------------------------------- Voice Live API
# Azure AI Services (kind=AIServices) resource in a region that serves the model.
# For natively supported models and their regions, see
# https://learn.microsoft.com/azure/ai-services/speech-service/voice-live#supported-models-and-regions
VOICE_LIVE_ENDPOINT=https://<resource>.services.ai.azure.com
# Leave empty to use DefaultAzureCredential, which is what Microsoft recommends.
# Keyless needs the Cognitive Services User and Foundry User roles — see the README.
VOICE_LIVE_API_KEY=
# gpt-realtime is the stable default. gpt-realtime-1.5 is newer; gpt-realtime-mini is cheaper.
VOICE_LIVE_MODEL=gpt-realtime
# WebSocket transport api-version.
VOICE_LIVE_API_VERSION=2026-04-10
VOICE_LIVE_VOICE=en-US-Ava:DragonHDLatestNeural
LOCALE=en-US

# --------------------------------------------------------------- routing policy
# Below this, the agent must ask a clarifying question instead of offering a
# destination. Flat across routes on purpose.
CONFIDENCE_THRESHOLD=0.75
# Answer-to-confirmed-route budget. Expiry sends the caller to reception.
ROUTE_TIME_BUDGET_MS=90000
# Clarifying questions allowed before falling back to a person.
MAX_CLARIFICATIONS=2
# The window between "connecting you now" and the actual transfer, during which
# the caller can still change their mind. Set to 0 to transfer immediately.
TRANSFER_DELAY_MS=1200

ROUTES_PATH=./config/routes.json
CALLERS_PATH=./config/callers.json

# ----------------------------------------------------------------------- audit
DB_PATH=./data/routing.db
# Route decisions and summaries are always stored. Utterance text is not, unless
# you turn this on deliberately.
PERSIST_TRANSCRIPTS=false
