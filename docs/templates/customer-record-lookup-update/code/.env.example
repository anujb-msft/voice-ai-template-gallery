# Leave PUBLIC_BASE_URL, ACS_ENDPOINT and VOICE_LIVE_ENDPOINT empty to run the
# offline console in simulation mode: no Azure, no network, fictional records.

# ------------------------------------------------------------------ web server
HOST=127.0.0.1
PORT=8097
# Public HTTPS base URL that ACS can reach, for the Event Grid webhook, the call
# callbacks, and the media socket, such as https://<your-tunnel>.devtunnels.ms.
# With devtunnel (npm run tunnel):
#   devtunnel host -p 8097 --allow-anonymous
PUBLIC_BASE_URL=

# ------------------------------------------------- Azure Communication Services
# Preferred: keyless. Set the endpoint only, such as
# https://<acs>.unitedstates.communication.azure.com, and the sample
# authenticates with DefaultAzureCredential — `az login` locally, managed
# identity in Azure. No ACS key is ever written to disk. The signed-in identity
# needs the "Communication and Email Service Owner" role on the ACS resource.
ACS_ENDPOINT=

# Fallback, only if you cannot use Entra. If both are set, ACS_ENDPOINT wins.
# ACS_CONNECTION_STRING=endpoint=https://<acs>.communication.azure.com/;accesskey=<key>

# The Teams cloud of the transfer target. Change it only for a sovereign tenant.
TEAMS_CLOUD=public

# ------------------------------------------------------------- Voice Live API
# Azure AI Services resource, such as https://<resource>.services.ai.azure.com
VOICE_LIVE_ENDPOINT=
# Leave empty to use DefaultAzureCredential, which is what Microsoft recommends.
# Keyless needs the Cognitive Services User and Foundry User roles — see the README.
VOICE_LIVE_API_KEY=
VOICE_LIVE_MODEL=gpt-realtime
# WebSocket transport api-version.
VOICE_LIVE_API_VERSION=2026-04-10
VOICE_LIVE_VOICE=en-US-Ava:DragonHDLatestNeural
# The opening language, the standing model instructions, and the transcription
# hint. Pick a voice that speaks it.
LOCALE=en-US

# ------------------------------------------------------------------------- CRM
# sqlite: a local fixture CRM in CRM_DB_PATH, seeded on first run (the default).
# memory: the same records in the process, reseeded on every start.
# dataverse: a documented stub; every method throws until you implement it.
CRM_ADAPTER=sqlite
CRM_DB_PATH=./data/crm.db

# Point these at *.local.json copies to try the sample with your own reps,
# records and transfer target without putting real IDs into the shipped config.
# config/*.local.json is gitignored.
CRM_SEED_PATH=./config/crm-seed.json
REPS_PATH=./config/reps.json
ROUTING_PATH=./config/routing.json
WRITABLE_FIELDS_PATH=./config/writable-fields.json
PICKLISTS_PATH=./config/picklists.json

# Passed to the Dataverse adapter stub, which does not use them yet.
DATAVERSE_URL=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# ---------------------------------------------------------------------- policy
# What "today" and "Friday" mean for due dates and close dates.
TIME_ZONE=America/Los_Angeles
# The undo window between "yes, save it" and the write. A mind change inside it
# writes nothing. Set to 0 to write at once.
COMMIT_UNDO_MS=6000
# The whole call. At WRAP_UP_MS the agent warns and keeps an unconfirmed update
# as a draft; at CALL_TIME_BUDGET_MS it says goodbye.
CALL_TIME_BUDGET_MS=480000
WRAP_UP_MS=420000
# Reported by /health. The flow asks every registered mobile for the PIN.
PIN_REQUIRED_FOR_PSTN=true

# ----------------------------------------------------------------------- audit
# Decisions are always audited. What was said is added only if you turn this on
# deliberately.
TRANSCRIPT_RETENTION=false

# ------------------------------------------------------------------------ demo
# Simulation mode only. Where the demo clock starts: empty or demo-day for
# Wednesday, June 10, 2026, at noon Pacific (the scripted demo's day), real for
# the real time, or an ISO 8601 time. The console's clock buttons can still move
# it. Ignored when the sample answers real calls.
DEMO_NOW=
